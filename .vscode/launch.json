{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "internalConsole",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PYDEVD_WARN_EVALUATION_TIMEOUT": "60"
            }
        },
        {
            "name": "Debug current file (step into pyspark)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "internalConsole",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PYDEVD_WARN_EVALUATION_TIMEOUT": "60"
            }
        }
    ]
}
